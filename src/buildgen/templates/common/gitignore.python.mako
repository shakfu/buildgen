<%!
from buildgen.skbuild.maturin import resolve
%>\
# Build
build/
dist/
*.egg-info/
*.so
*.pyd

# Virtual environments
.venv/
venv/
.uv/

# Cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

<%
_opts = context.get("options") or {}
_m = resolve(_opts) if _opts.get("maturin") else None
%>\
% if _m:
# Cargo
target/
% if _m.generated_module:
# Generated by maturin on each build
src/${name}/_core/
% endif

% endif
# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
